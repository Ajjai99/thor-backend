{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "With",
                "Args": {
                  "filter": "Thor.Core.Logging.ExcludeTenantLogGroupEvents, Thor.Core"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "Async",
                "Args": {
                  "configure": [
                    {
                      "Name": "Console",
                      "Args": {
                        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} (TenantId={TenantId}): {Message:lj}{NewLine}{Exception}"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "task-api-route": {
        "ClusterId": "task-api-cluster",
        "Match": {
          "Path": "/task-api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/task-api" }
        ]
      }
    },
    "Clusters": {
      "task-api-cluster": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5081/"
          }
        }
      }
    }
  }
}
